{
  "name": "nuef-portfolio-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Archived NUEF interactive landing page, restored as a safe frontend-only portfolio demo.",
  "scripts": {
    "dev": "node tools/dev-server.mjs",
    "build:css": "sass --no-source-map assets/scss/main.scss:assets/css/style.css assets/scss/layout/_demo.scss:assets/css/demo.css",
    "watch:css": "sass --watch --no-source-map assets/scss/main.scss:assets/css/style.css assets/scss/layout/_demo.scss:assets/css/demo.css",
    "check": "node tools/check.mjs && node tools/test-scroll.mjs"
  },
  "devDependencies": {
    "sass": "^1.77.0"
  }
}
